  display: "block",
  width: "100%",
  padding: 14,
  marginTop: 14,
  border: 0,
  borderRadius: 10,
  background: "#b832a8",
  color: "white",
  fontSize: 16,
  fontWeight: "bold",
  cursor: "pointer",
};
