  const [profitResetAt, setProfitResetAt] = useState<string | null>(null);
  const [showArchivedOrders, setShowArchivedOrders] = useState(false);
  const [paymentMethods, setPaymentMethods] = useState<PaymentMethod[]>([]);
  const [shippingGovernorates, setShippingGovernorates] = useState<ShippingGovernorate[]>([]);
  const [storeContent, setStoreContent] = useState<StoreContent>(DEFAULT_STORE_CONTENT);
