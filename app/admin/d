  const [costPrice, setCostPrice] = useState("");
  const [stock, setStock] = useState("0");
  const [price, setPrice] = useState("");
  const [images, setImages] = useState<string[]>([]);

  const [paymentLabel, setPaymentLabel] = useState("");
  const [paymentDetails, setPaymentDetails] = useState("");

  const [message, setMessage] = useState("");

  async function loadStoreContent() {
    const { data, error } = await supabase
      .from("store_settings")
      .select("setting_key, setting_value")
      .in("setting_key", ["top_bar", "hero_banner", "promotions", "about", "footer", "homepage_sections"]);

    if (error) throw error;
    const next = { ...DEFAULT_STORE_CONTENT };
    for (const row of data || []) {
      if (row.setting_key in next) {
        (next as any)[row.setting_key] = {
          ...(DEFAULT_STORE_CONTENT as any)[row.setting_key],
          ...(row.setting_value || {}),
        };
      }
    }
    setStoreContent(next);
    setPromotionLines((next.promotions.items || []).map((item) => `${item.title}${item.description ? ` | ${item.description}` : ""}`).join("\n"));
  }

  async function saveStoreSetting<K extends keyof StoreContent>(key: K, value: StoreContent[K]) {
    const payload = { ...value, published: true };
    const { error } = await supabase.from("store_settings").upsert(
      { setting_key: key, setting_value: payload, updated_at: new Date().toISOString() },
      { onConflict: "setting_key" }
    );
    if (error) throw error;
    setStoreContent((current) => ({ ...current, [key]: payload }));
  }

  async function uploadStoreContentImage(file: File) {
    const extension = file.name.split(".").pop()?.toLowerCase() || "jpg";
    const path = `banners/${Date.now()}-${Math.random().toString(36).slice(2)}.${extension}`;
    const { error } = await supabase.storage.from("store-content").upload(path, file, {
      cacheControl: "3600", upsert: false, contentType: file.type,
    });
    if (error) throw error;
    const { data } = supabase.storage.from("store-content").getPublicUrl(path);
    return data.publicUrl;
  }

  async function saveCategories(nextCategories: StoreCategory[]) {
    const current = storeContent.homepage_sections || DEFAULT_STORE_CONTENT.homepage_sections;
    await saveStoreSetting("homepage_sections", { ...current, enabled: true, categories: nextCategories });
  }

  async function renameMainCategory(oldName: string, newName: string) {
    const clean = newName.trim();
    if (!clean) return setMessage("اكتبي اسم القسم.");
    if (managedCategories.some((item) => item.name !== oldName && item.name.trim() === clean)) return setMessage("اسم القسم موجود بالفعل.");
    try {
      setLoading(true);
      const { error } = await supabase.from("products").update({ category: clean }).eq("category", oldName);
      if (error) throw error;
      const next = managedCategories.map((item) => item.name === oldName ? { ...item, name: clean } : item);
      await saveCategories(next);
      setProducts((old) => old.map((item) => item.category === oldName ? { ...item, category: clean } : item));
      setCategory(clean);
      setMessage("تم تغيير اسم القسم وتحديث المنتجات المرتبطة به ❤️");
    } catch (e) { setMessage(e instanceof Error ? e.message : "تعذر تعديل القسم"); }
    finally { setLoading(false); }
  }

  async function renameSubcategory(parentName: string, oldName: string, newName: string) {
    const clean = newName.trim();
    if (!clean) return setMessage("اكتبي اسم القسم الفرعي.");
    const parent = managedCategories.find((item) => item.name === parentName);
    if (parent?.subcategories.some((item) => item.name !== oldName && item.name.trim() === clean)) return setMessage("اسم القسم الفرعي موجود بالفعل.");
    try {
      setLoading(true);
      const { error } = await supabase.from("products").update({ subcategory: clean }).eq("category", parentName).eq("subcategory", oldName);
      if (error) throw error;
      const next = managedCategories.map((item) => item.name === parentName ? { ...item, subcategories: item.subcategories.map((sub) => sub.name === oldName ? { ...sub, name: clean } : sub) } : item);
      await saveCategories(next);
      setProducts((old) => old.map((item) => item.category === parentName && item.subcategory === oldName ? { ...item, subcategory: clean } : item));
      setMessage("تم تعديل القسم الفرعي وتحديث المنتجات المرتبطة به ❤️");
    } catch (e) { setMessage(e instanceof Error ? e.message : "تعذر تعديل القسم الفرعي"); }
    finally { setLoading(false); }
  }

  async function addMainCategory() {
    const clean = categoryNameDraft.trim();
    if (!clean) return setMessage("اكتبي اسم القسم الجديد.");
    if (managedCategories.some((item) => item.name === clean)) return setMessage("القسم موجود بالفعل.");
    try {
      setLoading(true);
      await saveCategories([...managedCategories, { name: clean, image: "", subcategories: [] }]);
      setCategoryNameDraft("");
      setMessage("تمت إضافة القسم الرئيسي ❤️");
    } catch (e) { setMessage(e instanceof Error ? e.message : "تعذرت إضافة القسم"); }
    finally { setLoading(false); }
  }

  async function addSubcategory(parentName = subcategoryParentDraft) {
    const clean = subcategoryNameDraft.trim();
    const parent = managedCategories.find((item) => item.name === parentName);
    if (!parent) return setMessage("اختاري القسم الرئيسي أولاً.");
    if (!clean) return setMessage("اكتبي اسم القسم الفرعي.");
    if (parent.subcategories.some((item) => item.name === clean)) return setMessage("القسم الفرعي موجود بالفعل.");
    try {
      setLoading(true);
      const next = managedCategories.map((item) => item.name === parent.name ? { ...item, subcategories: [...item.subcategories, { name: clean, image: "" }] } : item);
      await saveCategories(next);
      setSubcategoryNameDraft("");
      setMessage("تمت إضافة القسم الفرعي ❤️");
    } catch (e) { setMessage(e instanceof Error ? e.message : "تعذرت إضافة القسم الفرعي"); }
    finally { setLoading(false); }
  }

  async function changeCategoryImage(parentName: string, file?: File, subName?: string) {
    if (!file) return;
    if (!file.type.startsWith("image/")) return setMessage("اختاري ملف صورة فقط.");
    try {
      setLoading(true);
      const url = await uploadStoreContentImage(file);
      const next = managedCategories.map((item) => item.name !== parentName ? item : subName
        ? { ...item, subcategories: item.subcategories.map((sub) => sub.name === subName ? { ...sub, image: url } : sub) }
        : { ...item, image: url });
      await saveCategories(next);
      setMessage("تم رفع صورة القسم وحفظها ❤️");
    } catch (e) { setMessage(e instanceof Error ? e.message : "تعذر رفع الصورة"); }
    finally { setLoading(false); }
  }

  async function deleteMainCategory(nameToDelete: string) {
    const used = products.some((item) => item.category === nameToDelete);
    if (used) return setMessage("لا يمكن حذف القسم لأنه يحتوي على منتجات. انقلي المنتجات لقسم آخر أولاً.");
    if (!window.confirm(`حذف القسم «${nameToDelete}»؟`)) return;
    try { setLoading(true); await saveCategories(managedCategories.filter((item) => item.name !== nameToDelete)); setMessage("تم حذف القسم."); }
    catch (e) { setMessage(e instanceof Error ? e.message : "تعذر حذف القسم"); }
    finally { setLoading(false); }
  }

  async function deleteSubcategory(parentName: string, subName: string) {
    const used = products.some((item) => item.category === parentName && item.subcategory === subName);
    if (used) return setMessage("لا يمكن حذف القسم الفرعي لأنه يحتوي على منتجات. انقلي المنتجات لقسم فرعي آخر أولاً.");
    if (!window.confirm(`حذف القسم الفرعي «${subName}»؟`)) return;
    try {
      setLoading(true);
      const next = managedCategories.map((item) => item.name === parentName ? { ...item, subcategories: item.subcategories.filter((sub) => sub.name !== subName) } : item);
      await saveCategories(next); setMessage("تم حذف القسم الفرعي.");
    } catch (e) { setMessage(e instanceof Error ? e.message : "تعذر حذف القسم الفرعي"); }
    finally { setLoading(false); }
  }

  async function loadProducts() {
    const [
      { data, error },
      { data: costRows, error: costError },
    ] = await Promise.all([
      supabase
        .from("products")
        .select(PRODUCT_PUBLIC_COLUMNS)
        .order("created_at", { ascending: false }),
      supabase.rpc("get_admin_product_costs"),
    ]);

    if (error) throw error;
    if (costError) throw costError;

    const costs = new Map<number, number>(
      ((costRows || []) as AdminProductCost[]).map((row) => [
        Number(row.product_id),
        Number(row.cost_price || 0),
      ])
    );

    setProducts((data || []).map((p) => ({
      id: Number(p.id),
      name: p.name,
      serial_number: p.serial_number || "",
      category: p.category,
      subcategory: p.subcategory || "",
      description: p.description || "",
      costPrice: costs.get(Number(p.id)) ?? 0,
      stock: Number(p.stock || 0),
      price: Number(p.price || 0),
      images: p.images || [],
    })));
  }

  async function loadPaymentMethods() {
    const { data, error } = await supabase
      .from("payment_settings")
      .select("*")
      .order("created_at", { ascending: true });

    if (error) throw error;
    setPaymentMethods(data || []);
  }

  async function loadShippingGovernorates() {
    const { data, error } = await supabase
      .from("shipping_governorates")
      .select("governorate, shipping_fee, enabled")
      .order("governorate", { ascending: true });

    if (error) throw error;
    setShippingGovernorates((data || []).map((item) => ({
      governorate: item.governorate,
      shipping_fee: Number(item.shipping_fee || 0),
      enabled: Boolean(item.enabled),
    })));
  }

  async function saveShippingGovernorate(item: ShippingGovernorate) {
    if (!Number.isFinite(item.shipping_fee) || item.shipping_fee < 0) {
      setMessage("اكتبي سعر شحن صحيح لا يقل عن صفر.");
      return;
    }

    try {
      setLoading(true);
      const { error } = await supabase.rpc("admin_update_shipping_governorate", {
        p_governorate: item.governorate,
        p_shipping_fee: item.shipping_fee,
        p_enabled: item.enabled,
      });

      if (error) throw error;
      setMessage(`تم حفظ إعدادات الشحن لمحافظة ${item.governorate} ❤️`);
      await loadShippingGovernorates();
    } catch (error) {
      console.error(error);
      setMessage(error instanceof Error ? error.message : "تعذر حفظ سعر الشحن.");
    } finally {
      setLoading(false);
    }
  }

  async function loadOrders() {
    const [ordersResult, profitSettingResult] = await Promise.all([
      supabase
        .from("orders")
        .select("*")
        .order("created_at", { ascending: false }),
      supabase
        .from("store_settings")
        .select("setting_value")
        .eq("setting_key", "profit_reset")
        .maybeSingle(),
    ]);

    if (ordersResult.error) throw ordersResult.error;
    if (profitSettingResult.error) throw profitSettingResult.error;

    const resetValue = profitSettingResult.data?.setting_value as
      | { reset_at?: string }
      | null;
    setProfitResetAt(resetValue?.reset_at || null);

    const formatted: Order[] = await Promise.all(
      (ordersResult.data || []).map(async (o) => {
        let receipt = "";

        if (o.receipt_url) {
          const { data: signed } = await supabase.storage
            .from("payment-receipts")
            .createSignedUrl(o.receipt_url, 3600);

          receipt = signed?.signedUrl || "";
        }

        return {
          id: Number(o.id),
          customerName: o.customer_name || "",
          phone: o.phone || "",
          address: o.address || "",
          items: Array.isArray(o.items) ? o.items : [],
          total: Number(o.total || 0),
          profit: Number(o.profit || 0),
          paymentMethod: o.payment_method || "",
          paymentStatus: o.payment_status || "pending",
          orderStatus: o.order_status || "pending",
          receipt,
          createdAt: o.created_at || "",
          archivedAt: o.archived_at || null,
        };
      })
    );

    setOrders(formatted);
  }

  async function archiveOrder(orderId: number) {
    if (!window.confirm("هننقل الطلب ده للأرشيف. هتقدري ترجعيه في أي وقت. متابعة؟")) return;

    try {
      setLoading(true);
      const { error } = await supabase.rpc("archive_store_order", {
        p_order_id: orderId,
      });
      if (error) throw error;
      await loadOrders();
      setMessage("تمت أرشفة الطلب، ويمكن استرجاعه من تبويب الأرشيف.");
    } catch (error) {
      console.error(error);
      setMessage(error instanceof Error ? error.message : "تعذرت أرشفة الطلب.");
    } finally {
      setLoading(false);
    }
  }

  async function restoreOrder(orderId: number) {
    if (!window.confirm("هل تريدين استرجاع الطلب إلى سجل الطلبات الحالي؟")) return;

    try {
      setLoading(true);
      const { error } = await supabase.rpc("restore_store_order", {
        p_order_id: orderId,
      });
      if (error) throw error;
      await loadOrders();
      setMessage("تم استرجاع الطلب إلى السجل الحالي ❤️");
    } catch (error) {
      console.error(error);
      setMessage(error instanceof Error ? error.message : "تعذر استرجاع الطلب.");
    } finally {
      setLoading(false);
    }
  }

  async function resetNetProfit() {
    if (!window.confirm("سيبدأ حساب صافي الربح من هذه اللحظة. الطلبات القديمة لن تُحذف، ويمكن مراجعتها في السجل والأرشيف. متابعة؟")) return;

    const resetAt = new Date().toISOString();
    try {
      setLoading(true);
      const { error } = await supabase.from("store_settings").upsert(
        {
          setting_key: "profit_reset",
          setting_value: { reset_at: resetAt },
          updated_at: resetAt,
        },
        { onConflict: "setting_key" }
      );
      if (error) throw error;
      setProfitResetAt(resetAt);
      setMessage("بدأ حساب صافي الربح من جديد. لم يتم حذف أي طلب أو بيانات قديمة.");
    } catch (error) {
      console.error(error);
      setMessage(error instanceof Error ? error.message : "تعذر بدء حساب الأرباح من جديد.");
    } finally {
      setLoading(false);
    }
  }

  async function refreshAll() {
    try {
      setLoading(true);
      await Promise.all([
        loadProducts(),
        loadOrders(),
        loadPaymentMethods(),
        loadShippingGovernorates(),
        loadStoreContent(),
      ]);
      setMessage("تم تحديث بيانات المتجر بنجاح ❤️");
    } catch (error) {
      console.error(error);
      setMessage("حدث خطأ أثناء تحميل البيانات.");
    } finally {
      setLoading(false);
    }
  }

  async function handleLogin() {
    if (!email.trim() || !password) {
      setMessage("اكتبي الإيميل وكلمة المرور.");
      return;
    }

    try {
      setLoading(true);

      const { error } = await supabase.auth.signInWithPassword({
        email: email.trim(),
        password,
      });

      if (error) throw error;

      const { data: isAdmin, error: adminCheckError } =
        await supabase.rpc("is_store_admin");

      if (adminCheckError || isAdmin !== true) {
        await supabase.auth.signOut();
        throw new Error("هذا الحساب غير مصرح له بدخول لوحة الإدارة.");
      }

      setIsLoggedIn(true);
      setPassword("");

      await Promise.all([
        loadProducts(),
        loadOrders(),
        loadPaymentMethods(),
        loadShippingGovernorates(),
        loadStoreContent(),
      ]);

      setMessage("تم تسجيل الدخول وتحميل بيانات المتجر ❤️");
    } catch (error) {
      console.error(error);
      setIsLoggedIn(false);
      setMessage(
        error instanceof Error ? error.message : "تعذر تسجيل الدخول."
      );
    } finally {
      setLoading(false);
    }
  }

  async function handleLogout() {
    try {
      setLoading(true);
      const { error } = await supabase.auth.signOut();
