    restoreAdminSession();

    const { data: { subscription } } = supabase.auth.onAuthStateChange(
      (_event, session) => {
        if (!session && active) setIsLoggedIn(false);
      }
    );

    return () => {
      active = false;
      subscription.unsubscribe();
    };
