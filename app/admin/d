  gridTemplateColumns: "repeat(auto-fit, minmax(160px, 1fr))",
  gap: 12,
};

const statStyle: CSSProperties = {
  background: "#281b35",
  padding: 18,
  borderRadius: 14,
};

const orderStyle: CSSProperties = {
  background: "#281b35",
  borderRadius: 14,
  padding: 18,
  marginBottom: 14,
};

