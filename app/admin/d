  function handleImages(files: FileList | null) {
    if (!files) return;

    const remaining = 5 - images.length;

    if (remaining <= 0) {
      setMessage("مسموح بحد أقصى 5 صور.");
      return;
    }

    const selected = Array.from(files).slice(0, remaining);

    if (selected.some((file) => !file.type.startsWith("image/"))) {
      setMessage("اختاري صورًا فقط.");
      return;
    }

    const readers = selected.map(
      (file) =>
        new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.onerror = () => reject();
          reader.readAsDataURL(file);
        })
    );

    Promise.all(readers)
      .then((newImages) => {
        setImages((old) => [...old, ...newImages].slice(0, 5));
        setMessage("تم تجهيز الصور.");
      })
      .catch(() => setMessage("حدث خطأ أثناء قراءة الصور."));
  }

  async function addProduct() {
    if (!name.trim()) {
      setMessage("اكتبي اسم المنتج.");
      return;
    }

    if (costPrice.trim() === "" || price.trim() === "") {
      setMessage("اكتبي سعر الشراء وسعر البيع.");
      return;
    }

    if (
      !Number.isFinite(Number(price)) ||
      Number(price) <= 0 ||
      !Number.isFinite(Number(costPrice)) ||
      Number(costPrice) < 0
    ) {
      setMessage("راجعي الأسعار المدخلة.");
      return;
    }

    if (!Number.isInteger(Number(stock)) || Number(stock) < 0) {
      setMessage("اكتبي كمية صحيحة لا تقل عن صفر.");
      return;
    }

    if (!serialNumber.trim()) {
      setMessage("اكتبي الرقم التسلسلي للمنتج.");
      return;
    }

    try {
      setLoading(true);
      const { data: existingSerial, error: serialCheckError } = await supabase
        .from("products").select("id")
        .eq("serial_number", serialNumber.trim()).maybeSingle();
      if (serialCheckError) throw serialCheckError;
      if (existingSerial) {
        setMessage("الرقم التسلسلي مستخدم بالفعل. اكتبي رقمًا مختلفًا.");
        return;
      }

      const { data, error } = await supabase
        .from("products")
        .insert({
          name: name.trim(),
          serial_number: serialNumber.trim(),
          category,
          subcategory,
          cost_price: Number(costPrice),
          stock: Number(stock),
          price: Number(price),
          images,
          active: true,
        })
        .select(PRODUCT_PUBLIC_COLUMNS)
        .single();

      if (error) throw error;

      setProducts((old) => [{
        id: Number(data.id),
        name: data.name,
        serial_number: data.serial_number || serialNumber.trim(),
        category: data.category,
        subcategory: data.subcategory || "",
        description: data.description || "",
        costPrice: Number(costPrice),
        stock: Number(data.stock || 0),
        price: Number(data.price || 0),
        images: data.images || [],
      }, ...old]);

      window.dispatchEvent(new Event("tota-products-updated"));

      setName("");
      setSerialNumber("");
      setCostPrice("");
      setStock("0");
      setPrice("");
      setImages([]);

      setMessage("تم حفظ المنتج في قاعدة البيانات بنجاح ❤️");
    } catch (error) {
      console.error(error);
      setMessage("تعذر حفظ المنتج. راجعي صلاحيات قاعدة البيانات وحجم الصور.");
    } finally {
      setLoading(false);
    }
  }

  function startEditingProduct(product: Product) {
    setEditingProductId(product.id);
    setEditProductForm({
      name: product.name,
      serial_number: product.serial_number || "",
      category: product.category,
      subcategory: product.subcategory || (managedCategories.find((item) => item.name === product.category)?.subcategories[0]?.name || ""),
      description: product.description || "",
      price: String(product.price),
      stock: String(product.stock),
    });
    setMessage("");
  }

  async function saveProductEdits(productId: number) {
    const productName = editProductForm.name.trim();
    const productPrice = Number(editProductForm.price);
    const productStock = Number(editProductForm.stock);

    if (!productName) {
      setMessage("اكتبي اسم المنتج.");
      return;
    }
    if (!editProductForm.serial_number.trim()) {
      setMessage("اكتبي الرقم التسلسلي للمنتج.");
      return;
    }

    if (
      editProductForm.price.trim() === "" ||
      !Number.isFinite(productPrice) ||
      productPrice <= 0
    ) {
      setMessage("اكتبي سعر بيع صحيح أكبر من صفر.");
      return;
    }

    if (
      editProductForm.stock.trim() === "" ||
      !Number.isInteger(productStock) ||
      productStock < 0
    ) {
      setMessage("اكتبي كمية صحيحة لا تقل عن صفر.");
      return;
    }

    if (editProductForm.subcategory && !(managedCategories.find((item) => item.name === editProductForm.category)?.subcategories || []).some((item) => item.name === editProductForm.subcategory)) {
      setMessage("اختاري قسمًا فرعيًا صحيحًا.");
      return;
    }

    try {
      setLoading(true);
      const { data: existingSerial, error: serialCheckError } = await supabase
        .from("products").select("id")
        .eq("serial_number", editProductForm.serial_number.trim())
        .neq("id", productId).maybeSingle();
      if (serialCheckError) throw serialCheckError;
      if (existingSerial) {
        setMessage("الرقم التسلسلي مستخدم في منتج آخر. اكتبي رقمًا مختلفًا.");
        return;
      }

      const { error } = await supabase
        .from("products")
        .update({
          name: productName,
          serial_number: editProductForm.serial_number.trim(),
          category: editProductForm.category,
          subcategory: editProductForm.subcategory,
          description: editProductForm.description.trim(),
          price: productPrice,
          stock: productStock,
        })
        .eq("id", productId);

      if (error) throw error;

      setProducts((old) =>
        old.map((product) =>
          product.id === productId
            ? {
                ...product,
                name: productName,
                serial_number: editProductForm.serial_number.trim(),
                category: editProductForm.category,
                subcategory: editProductForm.subcategory,
                description: editProductForm.description.trim(),
                price: productPrice,
                stock: productStock,
              }
            : product
        )
      );

      setEditingProductId(null);
      window.dispatchEvent(new Event("tota-products-updated"));
      setMessage("تم تعديل بيانات المنتج بنجاح ❤️");
    } catch (error) {
      console.error(error);
      setMessage(
        error instanceof Error
          ? `تعذر تعديل المنتج: ${error.message}`
          : "تعذر تعديل بيانات المنتج."
      );
    } finally {
      setLoading(false);
    }
  }

  async function deleteProduct(id: number) {
    if (!window.confirm("هل تريدين حذف المنتج؟")) return;

    try {
      setLoading(true);

      const { error } = await supabase
        .from("products")
        .delete()
        .eq("id", id);

      if (error) throw error;

      setProducts((old) => old.filter((p) => p.id !== id));
      window.dispatchEvent(new Event("tota-products-updated"));
      setMessage("تم حذف المنتج بنجاح.");
    } catch (error) {
      console.error(error);
      setMessage("تعذر حذف المنتج. قد يكون مرتبطًا بطلب سابق.");
    } finally {
      setLoading(false);
    }
  }

  async function reviewOrder(orderId: number, decision: "approve" | "reject") {
    const question =
      decision === "approve"
        ? "هل تأكدتِ من وصول التحويل وتريدين تأكيد الطلب؟"
        : "هل تريدين رفض الإيصال وإرجاع الكمية للمخزون؟";

    if (!window.confirm(question)) return;

    try {
      setLoading(true);

      const { error } = await supabase.rpc("admin_review_order", {
        p_order_id: orderId,
        p_decision: decision,
      });

      if (error) throw error;

      await Promise.all([loadOrders(), loadProducts()]);

      setMessage(
        decision === "approve"
          ? "تم قبول الإيصال وتأكيد الطلب ❤️"
          : "تم رفض الإيصال وإرجاع الكمية للمخزون."
      );
    } catch (error) {
      console.error(error);
      setMessage(
        error instanceof Error ? error.message : "تعذرت مراجعة الطلب."
      );
    } finally {
      setLoading(false);
    }
  }

  async function updateOrderStatus(orderId: number, newStatus: "preparing" | "shipped" | "delivered") {
    const order = orders.find((item) => item.id === orderId);
    if (!order) return;
    if (order.paymentStatus !== "approved") {
      setMessage("لا يمكن تحديث حالة طلب لم يتم قبول دفعه.");
      return;
    }

    const expectedNextStatus: Record<string, string> = {
      confirmed: "preparing",
      preparing: "shipped",
      shipped: "delivered",
    };
    if (expectedNextStatus[order.orderStatus] !== newStatus) {
      setMessage("لا يمكن تخطي مراحل تجهيز وشحن الطلب.");
      return;
    }

    const statusLabels: Record<string, string> = {
      preparing: "قيد التجهيز",
      shipped: "تم الشحن",
      delivered: "تم التسليم",
    };
    const question = newStatus === "delivered"
      ? `تأكيد تسليم الطلب رقم ${orderId}؟ سيتم إضافة نقاط العميل تلقائيًا مرة واحدة.`
      : `تأكيد تغيير حالة الطلب رقم ${orderId} إلى «${statusLabels[newStatus]}»؟`;
    if (!window.confirm(question)) return;

    try {
      setLoading(true);
      const { data, error } = await supabase.rpc("admin_update_order_status", {
        p_order_id: orderId,
        p_new_status: newStatus,
      });
      if (error) throw error;

      await loadOrders();
      const result = data as { points_added?: number; message?: string } | null;
      if (newStatus === "delivered") {
        const pointsAdded = Number(result?.points_added || 0);
        setMessage(pointsAdded > 0
          ? `تم تسجيل تسليم الطلب رقم ${orderId} وإضافة ${pointsAdded} نقطة للعميل ❤️`
          : `تم تسجيل تسليم الطلب رقم ${orderId}. لم تُضف نقاط جديدة لهذا الطلب.`);
      } else {
        setMessage(`تم تحديث حالة الطلب رقم ${orderId} إلى «${statusLabels[newStatus]}» ❤️`);
      }
    } catch (error) {
      console.error(error);
      setMessage(error instanceof Error ? error.message : "تعذر تحديث حالة الطلب.");
    } finally {
      setLoading(false);
    }
  }

  const activeOrders = orders.filter((order) => !order.archivedAt);
