            style={inputStyle}
          />

          <div style={{ display: "flex", flexWrap: "wrap", gap: 10 }}>
            {images.map((src, index) => (
              <div key={index} style={{ position: "relative" }}>
                <img
                  src={src}
                  alt="صورة المنتج"
                  style={{
                    width: 85,
                    height: 85,
                    objectFit: "contain",
                    background: "white",
                    borderRadius: 10,
                  }}
                />
                <button
                  onClick={() => setImages((old) => old.filter((_, i) => i !== index))}
                  style={{
                    position: "absolute",
                    top: 2,
                    right: 2,
                    background: "#a21b55",
                    color: "white",
                    border: 0,
                    borderRadius: 20,
                  }}
                >
                  ×
                </button>
              </div>
            ))}
          </div>

          <button onClick={addProduct} disabled={loading} style={buttonStyle}>
            {loading ? "جاري الحفظ..." : "+ حفظ وإضافة المنتج"}
          </button>
        </section>

        <section style={sectionStyle}>
          <h2>المنتجات ({filteredProducts.length} من {products.length})</h2>
          <label htmlFor="admin-product-search">البحث عن منتج بالرقم التسلسلي أو الاسم</label>
          <input
            id="admin-product-search"
            type="search"
            value={productSearch}
            onChange={(e) => setProductSearch(e.target.value)}
            placeholder="اكتبي الرقم التسلسلي أو اسم المنتج..."
            style={inputStyle}
            dir="auto"
          />
          {filteredProducts.length === 0 ? (
            <p style={{ color: "#cbb7d8", textAlign: "center", padding: 20 }}>
              {products.length === 0 ? "لا توجد منتجات مضافة حتى الآن." : "لم يتم العثور على منتج مطابق للبحث."}
            </p>
          ) : filteredProducts.map((product) => (
            <article key={product.id} style={orderStyle}>
              <h3>{product.name}</h3>
              <p>الرقم التسلسلي: {product.serial_number || "غير مسجل"}</p>
              <p>{product.category} — {product.subcategory}</p>
              {product.description && (
                <p style={{ whiteSpace: "pre-wrap" }}>{product.description}</p>
              )}
              <p>الكمية المتاحة: {product.stock}</p>
              <p>سعر الشراء: {money(product.costPrice)}</p>
              <p>سعر البيع: {money(product.price)}</p>
              <p style={{ color: "#f28be9" }}>
                ربح القطعة: {money(product.price - product.costPrice)}
              </p>

              {editingProductId === product.id && (
                <div
                  style={{
                    background: "#352342",
                    border: "1px solid #654879",
                    borderRadius: 12,
                    padding: 16,
                    margin: "14px 0",
                  }}
                >
                  <h4 style={{ color: "#f28be9", marginTop: 0 }}>تعديل بيانات المنتج</h4>

                  <label>اسم المنتج</label>
                  <input
                    value={editProductForm.name}
                    onChange={(e) =>
                      setEditProductForm((old) => ({ ...old, name: e.target.value }))
                    }
                    style={inputStyle}
                  />

                  <label>الرقم التسلسلي</label>
                  <input
                    value={editProductForm.serial_number}
                    onChange={(e) => setEditProductForm((old) => ({ ...old, serial_number: e.target.value }))}
                    style={inputStyle}
                    dir="auto"
                  />

                  <label>القسم الرئيسي</label>
                  <select value={editProductForm.category} onChange={(e) => { const nextCategory = e.target.value; setEditProductForm((old) => ({ ...old, category: nextCategory, subcategory: managedCategories.find((item) => item.name === nextCategory)?.subcategories[0]?.name || "" })); }} style={inputStyle}>
                    {managedCategories.map((item) => <option key={item.name} value={item.name}>{item.name}</option>)}
                  </select>

                  <label>القسم الفرعي</label>
                  <select value={editProductForm.subcategory} onChange={(e) => setEditProductForm((old) => ({ ...old, subcategory: e.target.value }))} style={inputStyle}>
                    <option value="">بدون قسم فرعي</option>
                    {(managedCategories.find((item) => item.name === editProductForm.category)?.subcategories || []).map((item) => <option key={item.name} value={item.name}>{item.name}</option>)}
                  </select>

                  <label>وصف المنتج</label>
                  <textarea
                    value={editProductForm.description}
                    onChange={(e) =>
                      setEditProductForm((old) => ({
                        ...old,
                        description: e.target.value,
                      }))
                    }
                    rows={4}
                    style={inputStyle}
                  />

                  <label>سعر البيع للعميل</label>
                  <input
                    type="number"
                    min="1"
                    step="0.01"
                    value={editProductForm.price}
                    onChange={(e) =>
                      setEditProductForm((old) => ({ ...old, price: e.target.value }))
                    }
                    style={inputStyle}
                  />

                  <label>الكمية المتاحة في المخزون</label>
                  <input
                    type="number"
                    min="0"
                    step="1"
                    value={editProductForm.stock}
                    onChange={(e) =>
                      setEditProductForm((old) => ({ ...old, stock: e.target.value }))
                    }
                    style={inputStyle}
                  />

                  <button
                    onClick={() => saveProductEdits(product.id)}
                    disabled={loading}
                    style={buttonStyle}
                  >
                    {loading ? "جاري الحفظ..." : "حفظ التعديلات"}
                  </button>

                  <button
                    onClick={() => setEditingProductId(null)}
                    disabled={loading}
                    style={{
                      ...buttonStyle,
                      background: "#654879",
                    }}
                  >
                    إلغاء التعديل
                  </button>
                </div>
              )}

              <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
                {product.images.map((src, index) => (
                  <img
                    key={index}
                    src={src}
                    alt={product.name}
                    style={{
                      width: 65,
                      height: 65,
                      objectFit: "contain",
                      background: "white",
                      borderRadius: 8,
                    }}
                  />
                ))}
              </div>

              <button
                onClick={() => startEditingProduct(product)}
                disabled={loading}
                style={{ ...buttonStyle, background: "#7136a8" }}
              >
                تعديل بيانات المنتج
              </button>

              <button
                onClick={() => deleteProduct(product.id)}
                disabled={loading}
                style={{ ...buttonStyle, background: "#a52b50" }}
              >
                حذف المنتج
              </button>
            </article>
          ))}
        </section>

        {message && <p style={{ color: "#f5a3ed" }}>{message}</p>}
      </div>
    </main>
  );
}

function Stat({ title, value }: { title: string; value: string | number }) {
  return (
    <div style={statStyle}>
      <p style={{ color: "#cbb7d8" }}>{title}</p>
      <strong style={{ color: "#f28be9", fontSize: 22 }}>{value}</strong>
    </div>
  );
}

